DB_NAME=protecciones
DB_USER=postgres
DB_PASSWORD=cambiar_esta_password
DB_PORT=5433
POSTGRES_VERSION=16

# Secreto de firma de los JWT de login (ver docs/autenticacion.md). Generar
# uno propio largo y aleatorio antes de un despliegue real.
JWT_SECRET=cambiar-este-secreto-en-produccion-por-uno-largo-y-aleatorio
JWT_EXPIRATION_MS=28800000

# Resumen ejecutivo del dashboard y Copiloto IA (opcional). Sin esto, el
# resto del sistema funciona igual pero sin esas funcionalidades. Clave
# gratis en https://aistudio.google.com/apikey
# Admite varias claves separadas por coma (una por cuenta de Google AI
# Studio) para repartir el uso entre varias cuotas gratuitas: rota
# automaticamente a la siguiente cuando una devuelve 429.
# Ejemplo: GEMINI_API_KEY=clave-cuenta-1,clave-cuenta-2,clave-cuenta-3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
