DB_NAME=protecciones
DB_USER=postgres
DB_PASSWORD=cambiar_esta_password
DB_PORT=5433
POSTGRES_VERSION=16

# Secreto de firma de los JWT de login (ver docs/autenticacion.md). Obligatorio:
# sin esta variable la app no arranca (ni local ni en Docker). Generar un valor
# propio, largo y aleatorio (ej: openssl rand -base64 48), nunca reusar este placeholder.
JWT_SECRET=cambiar-este-secreto-en-produccion-por-uno-largo-y-aleatorio
JWT_EXPIRATION_MS=28800000

# Resumen ejecutivo del dashboard y Copiloto IA (opcional). Sin esto, el
# resto del sistema funciona igual pero sin esas funcionalidades. Clave
# gratis en https://aistudio.google.com/apikey
# Admite varias claves separadas por coma (una por cuenta de Google AI
# Studio) para repartir el uso entre varias cuotas gratuitas: rota
# automaticamente a la siguiente cuando una devuelve 429.
# Ejemplo: GEMINI_API_KEY=clave-cuenta-1,clave-cuenta-2,clave-cuenta-3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origenes permitidos por CORS, separados por coma. Por defecto solo
# localhost/127.0.0.1 (dev y build dockerizado). En un deploy real, definir
# el dominio publico del frontend (ej: https://protecciones.epec.com.ar),
# sino el navegador va a rechazar las respuestas del backend por CORS.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Solo aplica a docker-compose.prod.yml (servicio "backup"): cantidad de días
# que se conservan los dumps de Postgres en docker/backups/ antes de borrarlos.
BACKUP_RETENTION_DIAS=14
