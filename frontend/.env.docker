# Relativa: el propio nginx del frontend reenvía /api al backend (ver
# frontend/nginx.conf), así queda todo bajo el mismo origen tanto accedido
# directo (docker-compose.override.yml, dev) como detrás del proxy TLS
# (docker-compose.prod.yml) — sin depender de CORS ni de un puerto fijo.
VITE_API_BASE_URL=/api
VITE_APP_NAME=Protecciones Trazabilidad
